class Solution {
public:

    int Capacity(vector<int>& arr, int value) {
        int sum = 0, count = 1;
        for(int i = 0; i < arr.size(); i++) {
            if(sum + arr[i] > value) {
                count++;
                sum = 0;
            }
            sum += arr[i];
        }
        return count;
    }
    int shipWithinDays(vector<int>& arr, int d) {
        int total = 0;
        int maxi = 0;
        for(int i = 0; i < arr.size(); i++) {
            total += arr[i];
            maxi = max(maxi, arr[i]);
        }
        int low = maxi;
        int high = total;
        while(low <= high) {
            int mid = low + (high - low) / 2;
            int count = Capacity(arr, mid);
            if(count <= d) {
                high = mid - 1;
            }
            else {
                low = mid + 1;
            }
        }
        return low;
    }
};