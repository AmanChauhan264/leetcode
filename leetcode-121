class Solution {
public:
    int maxProfit(vector<int>& arr) {
    int mini = arr[0];
    int maxprofit = 0;
    int n = arr.size();
    for(int i = 0; i<n; i++){
        int cost = arr[i] - mini;
        maxprofit = max(maxprofit, cost);
        mini= min(mini, arr[i]);
    }
    return maxprofit;
    }
};